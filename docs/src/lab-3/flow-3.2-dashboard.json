[
    {
        "id": "broker_hivemq",
        "type": "mqtt-broker",
        "name": "HiveMQ Public",
        "broker": "broker.hivemq.com",
        "port": "1883",
        "clientid": "",
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "birthTopic": "",
        "birthQos": "0",
        "birthPayload": "",
        "closeTopic": "",
        "closeQos": "0",
        "closePayload": "",
        "willTopic": "",
        "willQos": "0",
        "willPayload": ""
    },
    {
        "id": "iot_tab",
        "type": "ui_tab",
        "name": "IoT Monitoring",
        "icon": "dashboard",
        "disabled": false,
        "hidden": false
    },
    {
        "id": "site_group",
        "type": "ui_group",
        "name": "Site A-01 Sensors",
        "tab": "iot_tab",
        "order": 1,
        "disp": true,
        "width": "6",
        "collapse": false,
        "className": ""
    },
    {
        "id": "status_group",
        "type": "ui_group",
        "name": "Site Status",
        "tab": "iot_tab",
        "order": 2,
        "disp": true,
        "width": "6",
        "collapse": false,
        "className": ""
    },
    {
        "id": "mqtt_tlm",
        "type": "mqtt in",
        "name": "Telemetry",
        "topic": "kmutnb/+/telemetry",
        "qos": "0",
        "datatype": "json",
        "broker": "broker_hivemq",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 150,
        "y": 120,
        "wires": [
            [
                "extract_tlm"
            ]
        ]
    },
    {
        "id": "extract_tlm",
        "type": "function",
        "name": "Extract Sensors",
        "func": "msg.payload = {\n    temperature: msg.payload.temperature,\n    humidity: msg.payload.humidity,\n    light: msg.payload.light\n};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 120,
        "wires": [
            [
                "gauge_temp",
                "gauge_hum",
                "chart_light"
            ]
        ]
    },
    {
        "id": "gauge_temp",
        "type": "ui_gauge",
        "name": "Temperature",
        "group": "site_group",
        "order": 1,
        "width": 0,
        "height": 0,
        "gtype": "gage",
        "title": "Temperature",
        "label": "°C",
        "format": "{{value}}",
        "min": 0,
        "max": "50",
        "colors": [
            "#00b500",
            "#e6e600",
            "#ca3838"
        ],
        "seg1": "32",
        "seg2": "35",
        "diff": false,
        "x": 610,
        "y": 60,
        "wires": []
    },
    {
        "id": "gauge_hum",
        "type": "ui_gauge",
        "name": "Humidity",
        "group": "site_group",
        "order": 2,
        "width": 0,
        "height": 0,
        "gtype": "gage",
        "title": "Humidity",
        "label": "%",
        "format": "{{value}}",
        "min": 0,
        "max": "100",
        "colors": [
            "#00b500",
            "#e6e600",
            "#ca3838"
        ],
        "seg1": "70",
        "seg2": "80",
        "diff": false,
        "x": 610,
        "y": 120,
        "wires": []
    },
    {
        "id": "chart_light",
        "type": "ui_chart",
        "name": "Light Chart",
        "group": "site_group",
        "order": 3,
        "width": 0,
        "height": 0,
        "label": "Light (ADC)",
        "chartType": "line",
        "legend": "false",
        "xformat": "HH:mm:ss",
        "interpolate": "linear",
        "nodata": "",
        "dot": false,
        "ymin": "0",
        "ymax": "4095",
        "removeOlder": "10",
        "removeOlderPoints": "",
        "removeOlderUnit": "60",
        "cutout": 0,
        "useOneColor": false,
        "useUTC": false,
        "colors": [
            "#1f77b4",
            "#aec7e8",
            "#ff7f0e",
            "#2ca02c",
            "#98df8a",
            "#d62728",
            "#ff9896",
            "#9467bd",
            "#c5b0d5"
        ],
        "outputs": 1,
        "x": 610,
        "y": 180,
        "wires": [
            []
        ]
    },
    {
        "id": "mqtt_hb",
        "type": "mqtt in",
        "name": "Heartbeat",
        "topic": "kmutnb/+/heartbeat",
        "qos": "0",
        "datatype": "json",
        "broker": "broker_hivemq",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 150,
        "y": 280,
        "wires": [
            [
                "extract_hb"
            ]
        ]
    },
    {
        "id": "extract_hb",
        "type": "function",
        "name": "Extract Status",
        "func": "msg.payload = msg.payload.status;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 280,
        "wires": [
            [
                "text_status"
            ]
        ]
    },
    {
        "id": "text_status",
        "type": "ui_text",
        "name": "Status",
        "group": "status_group",
        "order": 1,
        "width": 0,
        "height": 0,
        "label": "Site Status",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "x": 610,
        "y": 280,
        "wires": []
    }
]